# Backend API base URL (must include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Public site origin — used for canonical URLs / OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client id (web). Use the same value as the server's
# GOOGLE_CLIENT_ID. Leave empty to hide Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# AI assistant configuration (server-side only — never NEXT_PUBLIC_*).
# -----------------------------------------------------------------------------
# Pick the active provider. Supported: openrouter | openai | anthropic | gemini
# Defaults to "openrouter" if unset.
AI_PROVIDER=openrouter

# Model id for the active provider. If unset, a sensible default per
# provider is used (e.g. "openai/gpt-4o-mini" for OpenRouter,
# "claude-3-5-haiku-latest" for Anthropic, "gemini-1.5-flash" for Gemini).
# Examples for OpenRouter:
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
#   google/gemini-2.0-flash-001
#   meta-llama/llama-3.3-70b-instruct
AI_MODEL=

# Generic API key. Used as a fallback when no provider-specific key is set.
AI_API_KEY=

# Provider-specific keys. The active provider's key takes precedence
# over AI_API_KEY, so you can keep multiple keys side-by-side and
# switch providers by changing AI_PROVIDER alone.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: hard cap on output tokens per turn (default 1024).
AI_MAX_TOKENS=

# Optional: sampling temperature, 0..2 (default 0.4).
AI_TEMPERATURE=

# Optional: forwarded to OpenRouter as `HTTP-Referer` and `X-Title`
# headers for ranked routing. Defaults to NEXT_PUBLIC_SITE_URL and "Ibadah".
AI_SITE_URL=
AI_SITE_NAME=
