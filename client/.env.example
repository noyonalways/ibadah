# Backend API base URL (must include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Public site origin — used for canonical URLs / OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client id (web). Use the same value as the server's
# GOOGLE_CLIENT_ID. Leave empty to hide Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
