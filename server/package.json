{
  "name": "ibadah-server",
  "version": "0.3.1",
  "private": true,
  "description": "Ibadah backend — Express 5 + MongoDB",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --project tsconfig.dev.json -r tsconfig-paths/register src/server.ts",
    "generate:changelog": "ts-node --project tsconfig.dev.json -r tsconfig-paths/register src/scripts/generateChangelog.ts",
    "build": "pnpm generate:changelog && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:admin": "pnpm build && node dist/scripts/seedAdmin.js",
    "seed:db": "pnpm build && node dist/scripts/seedDatabase.js",
    "backfill:missed-salah": "pnpm build && node dist/scripts/backfillMissedSalah.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@faker-js/faker": "^10.5.0",
    "@google/generative-ai": "^0.24.1",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "node-cron": "^4.5.0",
    "openai": "^6.39.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.18.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}