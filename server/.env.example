# --- App ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ibadah?retryWrites=true&w=majority

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=replace-with-a-strong-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-strong-random-string
JWT_REFRESH_EXPIRES_IN=30d

# --- Hashing ---
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
CLIENT_URL=http://localhost:3000
CORS_SUPPORT_URL="http://localhost:3000,http://localhost:3001"

# --- Google OAuth (optional) ---
# Get one at https://console.cloud.google.com/apis/credentials.
# Use the same client id for both the server (GOOGLE_CLIENT_ID) and the
# client (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
#
# The flow uses Passport.js + the OAuth 2.0 Authorization Code redirect:
#   1. Client → GET ${API}/auth/google                  (sets state JWT)
#   2. Browser redirects to accounts.google.com         (Google consent)
#   3. Google → GET ${API}/auth/google/callback         (we verify code)
#   4. Server redirects to ${CLIENT_URL}${CLIENT_OAUTH_CALLBACK_PATH}
#      with a single-use opaque ?code= for the SPA to exchange.
#
# The Google client secret IS required for this flow — without it the
# server can't redeem the auth code Google hands back.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match exactly one of the "Authorized redirect URIs" on the
# OAuth client. For local dev the default below works.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
# Path on the SPA that handles the post-consent redirect.
CLIENT_OAUTH_CALLBACK_PATH=/auth/callback

# --- Admin bootstrap (consumed by `pnpm seed:admin` only) ---
# These vars are NEVER read by the running app — only by the seed script.
# Run the script once after first deploy, then rotate or remove them.
ADMIN_EMAIL=admin@ibadah.local
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Ibadah Admin
# Set to "true" to force-overwrite the password of an existing admin.
ADMIN_FORCE_PASSWORD_RESET=false

# --- AI Configuration ---
# Provider: openrouter, openai, anthropic, gemini (default: openrouter)
AI_PROVIDER=openrouter
# Model: provider-specific model id (defaults to provider-specific model)
AI_MODEL=openai/gpt-4o-mini
# API Keys (set the one matching your provider, or use AI_API_KEY as fallback)
AI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional AI settings
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.4
AI_SITE_URL=
AI_SITE_NAME=Ibadah
