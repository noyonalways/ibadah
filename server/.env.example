# --- App ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ibadah?retryWrites=true&w=majority

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=replace-with-a-strong-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-strong-random-string
JWT_REFRESH_EXPIRES_IN=30d

# --- Hashing ---
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
CLIENT_URL=http://localhost:3000
