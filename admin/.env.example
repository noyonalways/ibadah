# Backend API base URL (must include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Admin panel public origin
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# AI admin copilot configuration (server-side only — never NEXT_PUBLIC_*).
# Mirrors the client app so deployments can use the same provider/key.
# -----------------------------------------------------------------------------
# Active provider: openrouter | openai | anthropic | gemini  (default: openrouter)
AI_PROVIDER=openrouter

# Model id for the active provider. Defaults to a provider-appropriate
# small model when unset.
AI_MODEL=

# Generic API key — used as a fallback when no provider-specific key is set.
AI_API_KEY=

# Provider-specific API keys.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional knobs.
AI_MAX_TOKENS=
AI_TEMPERATURE=

# OpenRouter ranking headers. Default to NEXT_PUBLIC_ADMIN_URL and "Ibadah Admin".
AI_SITE_URL=
AI_SITE_NAME=
